{
  "name": "zmodem2-wasm",
  "version": "1.0.1",
  "description": "WebAssembly compilation of the zmodem2 Rust crate by Jarkko Sakkinen (https://codeberg.org/jarkko/zmodem2)",
    "scripts": {
    "dev:ts": "vite --config build/vite.config.ts",
    "dev:wasm": "npm run build && vite --config build/vite-wasm.config.ts",
    "build:wasm": "wasm-pack build --target web --out-dir pkg",
    "build": "node build/build.js",
    "prepublishOnly": "npm run build",
    "start": "npm run dev:wasm",
    "backend": "ts-node src/server/index.ts",
    "lint": "ts-standard --verbose",
    "fix": "ts-standard --fix"
  },
  "keywords": [
    "zmodem",
    "zmodem2",
    "wasm",
    "webassembly",
    "terminal",
    "file-transfer"
  ],
  "homepage": "https://github.com/zxdong262/zmodem2-wasm#readme",
  "bugs": {
    "url": "https://github.com/zxdong262/zmodem2-wasm/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zxdong262/zmodem2-wasm.git"
  },
  "license": "MIT",
  "author": "ZHAO Xudong <zxdong@gmail.com>",
  "type": "module",
  "main": "./pkg/zmodem2_wasm.js",
  "module": "./pkg/zmodem2_wasm.js",
  "types": "./pkg/zmodem2_wasm.d.ts",
  "files": [
    "pkg",
    "README.md",
    "README_cn.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.9.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.5.8",
    "@vitejs/plugin-react": "^4.3.4",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "dotenv": "^17.3.1",
    "express": "^4.18.2",
    "express-ws": "^5.0.2",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "ssh2": "^1.14.0",
    "standard": "^17.1.0",
    "ts-node": "^10.9.1",
    "ts-standard": "^12.0.2",
    "typescript": "^5.3.3",
    "vite": "^7.3.1",
    "ws": "^8.14.2",
    "zmodem-ts": "^1.0.8"
  }
}
